{
 "format": "unsloth-flow",
 "version": 1,
 "id": "showcase-quote-remix",
 "name": "Showcase: Quote remix (JSON + Jinja)",
 "description": "Seeded from the Hub dataset Abirate/english_quotes given as a bare repo id: a JSON-schema column remixes each quote, a Jinja expression lays out a share card from it, and a dropped helper feeds the Jinja. Preview, then Rows to Dataset.",
 "kind": "pipeline",
 "seed": 7,
 "params": [],
 "requirements": {
  "models": [
   {
    "ref": "writer",
    "kind": "chat",
    "repo": "unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF",
    "variant": "Q4_K_M",
    "optional": false,
    "note": "Writes the recipe rows through Unsloth Studio's local provider."
   }
  ]
 },
 "nodes": [
  {
   "id": "remix_col_1",
   "type": "recipe.column",
   "v": 1,
   "params": {
    "column": {
     "column_type": "sampler",
     "name": "persona",
     "drop": false,
     "sampler_type": "category",
     "params": {
      "values": [
       "a pirate captain",
       "a 1920s noir detective",
       "a sports commentator",
       "a Shakespearean actor",
       "a tech startup founder"
      ]
     }
    }
   },
   "pos": [
    420.0,
    0.0
   ],
   "size": null,
   "label": "persona",
   "group": "remix",
   "collapsed": false,
   "disabled": false
  },
  {
   "id": "remix_col_2",
   "type": "recipe.column",
   "v": 1,
   "params": {
    "column": {
     "column_type": "llm-structured",
     "name": "remix",
     "drop": false,
     "model_alias": "remixer",
     "prompt": "Quote: \"{{ quote }}\"\nAuthor: {{ author }}\n\nRewrite the quote as {{ persona }} would say it today, keep the meaning. Then rate the mood, give a one-line plain-English meaning and up to three short hashtags without the # sign.",
     "with_trace": "none",
     "extract_reasoning_content": false,
     "output_format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "remixed_quote",
       "meaning",
       "mood",
       "hashtags"
      ],
      "properties": {
       "remixed_quote": {
        "type": "string"
       },
       "meaning": {
        "type": "string"
       },
       "mood": {
        "type": "string",
        "enum": [
         "uplifting",
         "wry",
         "melancholy",
         "defiant",
         "romantic"
        ]
       },
       "hashtags": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "maxItems": 3
       }
      }
     }
    }
   },
   "pos": [
    740.0,
    0.0
   ],
   "size": null,
   "label": "remix",
   "group": "remix",
   "collapsed": false,
   "disabled": false
  },
  {
   "id": "remix_col_3",
   "type": "recipe.column",
   "v": 1,
   "params": {
    "column": {
     "column_type": "expression",
     "name": "byline",
     "drop": true,
     "dtype": "str",
     "expr": "{{ author | trim | replace(',', '') }}, as told by {{ persona }}"
    }
   },
   "pos": [
    740.0,
    180.0
   ],
   "size": null,
   "label": "byline",
   "group": "remix",
   "collapsed": false,
   "disabled": false
  },
  {
   "id": "remix_col_4",
   "type": "recipe.column",
   "v": 1,
   "params": {
    "column": {
     "column_type": "expression",
     "name": "share_card",
     "drop": false,
     "dtype": "str",
     "expr": "{% if remix.mood in ['uplifting', 'defiant'] %}🔥{% else %}🌙{% endif %} \"{{ remix.remixed_quote }}\"\n  ({{ byline }})\n{% for tag in remix.hashtags %}#{{ tag | replace(' ', '') }} {% endfor %}"
    }
   },
   "pos": [
    1060.0,
    0.0
   ],
   "size": null,
   "label": "share_card",
   "group": "remix",
   "collapsed": false,
   "disabled": false
  },
